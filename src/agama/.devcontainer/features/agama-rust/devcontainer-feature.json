{
  "id": "agama-rust",
  "version": "1.0.0",
  "name": "Agama Rust",
  "description": "Agama Rust backend development tools",
  "customizations": {
    "vscode": {
      "extensions": [
        // ------------------
        // RUST BACKEND EXTENSIONS
        // ------------------
