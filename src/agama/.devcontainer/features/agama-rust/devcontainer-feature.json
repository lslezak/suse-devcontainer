{
  "id": "agama-rust",
  "version": "1.0.0",
  "name": "Agama Rust",
  "description": "Agama Rust backend development tools (VS Code extensions and settings, the packages are installed in the Dockerfile)",
  "mounts": [
    {
      "source": "/run/avahi-daemon",
      "target": "/run/avahi-daemon",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "Grafana.vscode-jsonnet",
        "ms-vscode.cpptools-extension-pack"
      ]
    }
  }
}
