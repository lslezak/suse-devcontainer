{
  "id": "agama-all-in-one",
  "version": "1.0.0",
  "name": "Agama All-in-one",
  "description": "Agama development tools for all components (VS Code extensions and settings, the packages are installed in the Dockerfile)",
  "mounts": [
    {
      "source": "/run/avahi-daemon",
      "target": "/run/avahi-daemon",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "xml.fileAssociations": [
          {
            "pattern": "**/*.kiwi",
            "systemId": "file:///usr/local/share/kiwi/kiwi.rnc"
          }
        ]
      },
      "extensions": [
        // ------------------
        // LIVE ISO EXTENSIONS
        // ------------------
        // XML (*.kiwi) formatting support
        "redhat.vscode-xml",
        // ------------------
        // WEB FRONTEND EXTENSIONS
        // ------------------
        // interactive color picker
        "anseki.vscode-color",
        // ESlint integration
        "dbaeumer.vscode-eslint",
        // import autocompletion
        "christian-kohler.npm-intellisense",
        // ------------------
        // RUST BACKEND EXTENSIONS
        // ------------------
        // Rust support
        "rust-lang.rust-analyzer",
        // *.toml support
        "tamasfe.even-better-toml",
        // *.jsonnet support
        "Grafana.vscode-jsonnet",
        // C++ support
        "ms-vscode.cpptools-extension-pack",
        // ------------------
        // RUBY SERVICE EXTENSIONS
        // ------------------
        // Ruby support
        "Shopify.ruby-lsp",
        // autocomplete Ruby block ending 
        "kaiwood.endwise",
        // Generate Yardoc comments
        "pavlitsky.yard"
      ]
    }
  }
}
