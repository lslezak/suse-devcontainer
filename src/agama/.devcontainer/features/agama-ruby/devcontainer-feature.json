{
  "id": "agama-ruby",
  "version": "1.0.0",
  "name": "Agama Ruby",
  "description": "Agama Ruby service development tools (VS Code extensions and settings, the packages are installed in the Dockerfile)",
  "mounts": [
    {
      "source": "/run/avahi-daemon",
      "target": "/run/avahi-daemon",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "kaiwood.endwise",
        "pavlitsky.yard"
      ]
    }
  }
}
