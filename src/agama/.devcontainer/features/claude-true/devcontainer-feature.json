{
  "id": "claude-true",
  "version": "1.0.0",
  "name": "Anthropic Claude",
  "description": "Installs the Claude Code extension, the Google Cloud CLI and the default ~/.claude/settings.json file, logs into Google Cloud if needed",
  "customizations": {
    "vscode": {
      "settings": {
        "claudeCode.disableLoginPrompt": true
      },
      "extensions": ["Anthropic.claude-code"]
    }
  },
  "postCreateCommand": "[ -e ~/.claude/settings.json ] || install -D -m 644 /usr/local/share/devcontainer-claude/settings.json ~/.claude/settings.json",
  // interactive, not run by "devcontainer up --skip-post-attach" in the tests
  "postAttachCommand": "gcloud-login.sh"
}
