{
  "id": "agama",
  "version": "0.0.9",
  "name": "Agama",
  "description": "Development container for the Agama installer based on openSUSE Leap or openSUSE Tumbleweed.",
  "documentationURL": "https://github.com/lslezak/suse-devcontainer/tree/main/src/agama",
  "licenseURL": "https://github.com/lslezak/suse-devcontainer/blob/main/LICENSE",
  "publisher": "Ladislav Slezák",
  "options": {
    "imageVariant": {
      "type": "string",
      "description": "openSUSE base system:",
      "enum": ["leap:16.1", "leap:16.0", "tumbleweed"],
      "default": "leap:16.1"
    }
  },
  "platforms": ["Any"],
  "keywords": ["Agama", "installer", "openSUSE", "SUSE", "Leap", "Tumbleweed", "Gemini", "Claude"]
}
