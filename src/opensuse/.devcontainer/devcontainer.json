{
  // This file was generated from the "ghcr.io/lslezak/suse-devcontainer/opensuse" template.
  // To exclude the .devcontainer directory from the git repository run this command:
  //    echo "/.devcontainer/" >> .git/info/exclude
  // See more details in https://containers.dev/overview
  "name": "openSUSE ${templateOption:imageVariant}",
  "build": {
    "dockerfile": "Containerfile"
  },
  // Install optional support for the AI code assistants,
  // comment out the ones which you do not use
  "features": {
    // Install Google Gemini Code Assist support with SUSE specific config
    "./features/suse-gemini": {},
    // Install Anthropic Claude Code support with SUSE specific config
    "./features/suse-claude": {}
  },
  "remoteUser": "vscode",
  "postCreateCommand": "git config --global --add safe.directory /workspaces",
  "remoteEnv": {
    // Use vscode itself as the $EDITOR
    "EDITOR": "code --wait",
    // When the VSCode is closed the terminal history is not autosaved, force
    // saving the history after every command.
    "PROMPT_COMMAND": "history -a"
  },
  // These options are Podman specific, remove them when using Docker
  "runArgs": [
    // use the same time zone as the host (podman only, delete when using Docker)
    "--tz=local",
    // keep the current user and group ID (podman only, delete when using Docker)
    "--userns=keep-id",
    // disable SELinux isolation
    "--security-opt",
    "label=disable"
  ],
  "mounts": [
    // persist the user home directory (npm cache, shell history,...)
    // https://code.visualstudio.com/docs/devcontainers/tips-and-tricks#_persisting-user-profile
    // the "${devcontainerId}" suffix makes the volume unique for each project,
    // remove it if you want to share the home directory with other containers
    "source=devcontainer-home-${devcontainerId},target=/home/vscode,type=volume",
    // anonymous volume that gets destroyed on rebuild,
    // this allows VS Code to reinstall extensions and dotfiles
    "target=/home/vscode/.vscode-server,type=volume",
    // persistent extension cache to reinstall the extensions faster, you might share it with multiple containers
    "source=extension-cache,target=/home/vscode/.vscode-server/extensionsCache/,type=volume"
  ],
  "customizations": {
    "vscode": {
      // Set some VSCode setting specially for this container only
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        // disable all Copilot AI features
        "chat.disableAIFeatures": true,
        "[rpm-changes]": {
          "editor.rulers": [67]
        }
      },
      "extensions": [
        // ------------------
        // Some useful extensions, modify the list according to your project and your preferences
        // ------------------
        // highlight bug IDs, bug preview on hover
        "lslezak.bug-id",
        // syntax highlighting for the *.changes files
        "lslezak.rpm-changes",
        // spellchecker
        "streetsidesoftware.code-spell-checker",
        // load indentation style from .editorconfig files
        "EditorConfig.EditorConfig",
        // GitHub Actions integration
        "github.vscode-github-actions",
        // prettier autoformatter for JS, TS, YAML, JSON, Markdown...
        "esbenp.prettier-vscode",
        // shell programming
        "mads-hartmann.bash-ide-vscode",
        // Makefile support
        "ms-vscode.makefile-tools",
        // collect TODO, FIXME...
        "Gruntfuggly.todo-tree",
        // RPM *.spec support
        "RVSmartPorting.rpm-spec-ext",
        // YAML support
        "redhat.vscode-yaml",
        // systemd *.service files
        "hangxingliu.vscode-systemd-support",
        // show Markdown preview using the GitHub style
        "bierner.markdown-preview-github-styles",
        // render GitHub emoji (:smiley:) in Markdown
        "bierner.markdown-emoji",
        // Markdown editing (automatic TOC, table reformatting,...)
        "yzhang.markdown-all-in-one",
        // Rewrap paragraph
        "stkb.rewrap",
        // Live HTTP server
        "ritwickdey.LiveServer",
        // Markdown linter
        "DavidAnson.vscode-markdownlint",
        // MDX support (Markdown with JSX)
        "unifiedjs.vscode-mdx",
        // TROFF (man pages)
        "ban.troff",
        // BATS (Bash Automated Testing System)
        "jetmartin.bats",
        // Bookmarks
        "alefragnani.Bookmarks",
        // gettext *.po support
        "mrorz.language-gettext",
        // XML formatting support
        "redhat.vscode-xml",
        // CSS interactive color picker
        "anseki.vscode-color",
        // ESlint integration
        "dbaeumer.vscode-eslint",
        // NPM import autocompletion
        "christian-kohler.npm-intellisense",
        // Rust support
        "rust-lang.rust-analyzer",
        // *.toml support
        "tamasfe.even-better-toml",
        // *.jsonnet support
        "Grafana.vscode-jsonnet",
        // C++ support
        "ms-vscode.cpptools-extension-pack",
        // CMake support
        "ms-vscode.cmake-tools",
        // Python support
        "ms-python.python",
        // Python environments
        "ms-python.vscode-python-envs",
        // Python debugger
        "ms-python.debugpy",
        // Better Python indentation when typing
        "KevinRose.vsc-python-indent",
        // Ruby support
        "Shopify.ruby-lsp",
        // autocomplete Ruby block ending 
        "kaiwood.endwise",
        // Generate Ruby Yardoc comments
        "pavlitsky.yard"
      ]
    }
  }
}
