{
  // This file was generated from the "ghcr.io/lslezak/suse-devcontainer/opensuse" template.
  // To exclude the .devcontainer directory from the git repository run this command:
  //    echo ".devcontainer/" >> .git/info/exclude
  "name": "openSUSE ${templateOption:imageVariant}",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Optional AI code assistants, the "*-true" features install the VS Code
  // extension and the configuration, the "*-false" features do nothing.
  // Note: local features must be located in the .devcontainer directory in the
  // workspace, in VS Code do not store this configuration in the user data folder.
  "features": {
    // Install Google Gemini Code Assist support
    "./features/gemini-${templateOption:googleGemini}": {},
    // Install Anthropic Claude Code support
    "./features/claude-${templateOption:anthropicClaude}": {}
  },
  "remoteUser": "vscode",
  "postCreateCommand": "git config --global --add safe.directory /workspaces",
  "remoteEnv": {
    // Use vscode itself as the $EDITOR
    "EDITOR": "code --wait",
    // When the VSCode is closed the terminal history is not autosaved, force
    // saving the history after every command.
    "PROMPT_COMMAND": "history -a"
  },
  // These options are Podman specific, remove them when using Docker
  "runArgs": [
    // keep the current user and group ID (podman only, delete when using Docker)
    "--userns=keep-id",
    // disable SELinux isolation
    "--security-opt",
    "label=disable"
  ],
  "mounts": [
    // persist the user home directory (npm cache, shell history,...)
    // https://code.visualstudio.com/docs/devcontainers/tips-and-tricks#_persisting-user-profile
    // the "${devcontainerId}" suffix makes the volume unique for each project,
    // remove it if you want to share the home directory with other containers
    "source=devcontainer-home-${devcontainerId},target=/home/vscode,type=volume",
    // anonymous volume that gets destroyed on rebuild,
    // this allows VS Code to reinstall extensions and dotfiles
    "target=/home/vscode/.vscode-server,type=volume",
    // persistent extension cache to reinstall the extensions faster, you might share it with multiple containers
    "source=extension-cache,target=/home/vscode/.vscode-server/extensionsCache/,type=volume"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        // disable all Copilot AI features
        "chat.disableAIFeatures": true
      },
      "extensions": [
        // ------------------
        // GENERIC EXTENSIONS
        // ------------------
        // hightlight bug IDs, bug preview on hover
        "lslezak.bug-id",
        // syntax highlighting for the *.changes files
        "lslezak.rpm-changes",
        // spellchecker
        "streetsidesoftware.code-spell-checker",
        // load indentation style from .editorconfig files
        "EditorConfig.EditorConfig",
        // GitHub Actions integration
        "github.vscode-github-actions",
        // gettext *.po support
        "mrorz.language-gettext",
        // prettier autoformatter
        "esbenp.prettier-vscode",
        // shell programming
        "mads-hartmann.bash-ide-vscode",
        // Makefile support
        "ms-vscode.makefile-tools",
        // collect TODO, FIXME...
        "Gruntfuggly.todo-tree",
        // RPM *.spec support
        "RVSmartPorting.rpm-spec-ext",
        // YAML support
        "redhat.vscode-yaml",
        // systemd *.service files
        "hangxingliu.vscode-systemd-support",
        // ------------------
        // MARKDOWN SUPPORT
        // ------------------
        // show preview using the GitHub style
        "bierner.markdown-preview-github-styles",
        // render GitHub emoji (:smiley:)
        "bierner.markdown-emoji",
        // Markdown editing (automatic TOC, table reformatting,...)
        "yzhang.markdown-all-in-one"
      ]
    }
  }
}
