{
  "id": "opensuse",
  "version": "0.0.12",
  "name": "openSUSE",
  "description": "Development container based on openSUSE Leap or openSUSE Tumbleweed with common development tools and a non-root user.",
  "documentationURL": "https://github.com/lslezak/suse-devcontainer/tree/main/src/opensuse",
  "licenseURL": "https://github.com/lslezak/suse-devcontainer/blob/main/LICENSE",
  "publisher": "Ladislav Slezák",
  "options": {
    "imageVariant": {
      "type": "string",
      "description": "openSUSE base system:",
      "enum": ["leap:16.1", "leap:16.0", "tumbleweed"],
      "default": "leap:16.1"
    }
  },
  "platforms": ["Any"],
  "keywords": ["openSUSE", "SUSE", "Leap", "Tumbleweed", "Gemini", "Claude"]
}
